<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Mysthood Cyberdeck Matrix Profile</string>
    <key>PayloadDescription</key>
    <string>Deploys the Mysthood Cyber-HUD kiosk console and manages vehicle hotspot synchronization.</string>
    <key>PayloadIdentifier</key>
    <string>com.mysthood.cyberdeck.profile</string>
    <key>PayloadOrganization</key>
    <string>Mysthood Automotive Dynamics</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>D9A2F841-B831-4FE2-8411-2E90D483CB81</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadContent</key>
    <array>
        <!-- Standalone Mysthood HUD Launcher -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.mysthood.cyberdeck.webclip</string>
            <key>PayloadUUID</key>
            <string>7B910A54-3221-4CAE-A79B-F1492DF88188</string>
            <key>PayloadDisplayName</key>
            <string>Mysthood HUD</string>
            <key>PayloadDescription</key>
            <string>Installs the standalone Mysthood Cyberdeck Kiosk on your iOS home screen.</string>
            <key>PayloadOrganization</key>
            <string>Mysthood Automotive Dynamics</string>
            <key>Label</key>
            <string>Mysthood HUD</string>
            <key>URL</key>
            <string>https://rextex999.github.io/car-hub/</string>
            <key>FullScreen</key>
            <true/>
            <key>IsRemovable</key>
            <true/>
            <key>Precomposed</key>
            <true/>
        </dict>
        <!-- Vehicle Hotspot & In-Cabin Wi-Fi Auto-Link -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.mysthood.cyberdeck.wifi</string>
            <key>PayloadUUID</key>
            <string>1A689DC2-94C0-466D-BBE4-DC346FE41344</string>
            <key>PayloadDisplayName</key>
            <string>Mysthood Vehicle Hotspot Link</string>
            <key>PayloadDescription</key>
            <string>Automates secure in-vehicle Wi-Fi network joining and captive portal bypass.</string>
            <key>PayloadOrganization</key>
            <string>Mysthood Automotive Dynamics</string>
            <key>SSID_STR</key>
            <string>Vehicle-Hotspot</string>
            <key>HIDDEN_NETWORK</key>
            <false/>
            <key>AutoJoin</key>
            <true/>
            <key>CaptiveBypass</key>
            <true/>
            <key>EncryptionType</key>
            <string>WPA2</string>
            <key>Password</key>
            <string></string>
        </dict>
    </array>
</dict>
</plist>
