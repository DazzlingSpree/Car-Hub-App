<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>Mysthood Crimson Cyberdeck Profile</string>
    <key>PayloadDescription</key>
    <string>Deploys the Mysthood Crimson Cyber-HUD kiosk console and vehicle hotspot synchronization.</string>
    <key>PayloadIdentifier</key>
    <string>com.mysthood.cyberdeck.profile</string>
    <key>PayloadOrganization</key>
    <string>Mysthood Automotive Dynamics</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>D9A2F841-B831-4FE2-8411-2E90D483CB81</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadContent</key>
    <array>
        <!-- Standalone Mysthood HUD Launcher with Direct Root Icon Reference -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webClip.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.mysthood.cyberdeck.webclip</string>
            <key>PayloadUUID</key>
            <string>7B910A54-3221-4CAE-A79B-F1492DF88188</string>
            <key>PayloadDisplayName</key>
            <string>Mysthood HUD</string>
            <key>PayloadDescription</key>
            <string>Installs the standalone Mysthood Cyberdeck Kiosk on your iOS home screen.</string>
            <key>PayloadOrganization</key>
            <string>Mysthood Automotive Dynamics</string>
            <key>Label</key>
            <string>Mysthood HUD</string>
            <!-- Carries ?installed=true parameter for automatic dashboard handshake verification -->
            <key>URL</key>
            <string>https://rextex999.github.io/car-hub/?installed=true</string>
            <!-- Direct URL to your root icon.svg -->
            <key>IconURL</key>
            <string>https://rextex999.github.io/car-hub/icon.svg</string>
            <key>FullScreen</key>
            <true/>
            <key>IsRemovable</key>
            <true/>
            <key>Precomposed</key>
            <true/>
        </dict>
        <!-- In-Cabin Vehicle Wi-Fi / Hotspot Auto-Join -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.mysthood.cyberdeck.wifi</string>
            <key>PayloadUUID</key>
            <string>1A689DC2-94C0-466D-BBE4-DC346FE41344</string>
            <key>PayloadDisplayName</key>
            <string>Mysthood Vehicle Hotspot Link</string>
            <key>PayloadOrganization</key>
            <string>Mysthood Automotive Dynamics</string>
            <key>SSID_STR</key>
            <string>Vehicle-Hotspot</string>
            <key>HIDDEN_NETWORK</key>
            <false/>
            <key>AutoJoin</key>
            <true/>
            <key>CaptiveBypass</key>
            <true/>
            <key>EncryptionType</key>
            <string>WPA2</string>
            <key>Password</key>
            <string></string>
        </dict>
    </array>
</dict>
</plist>
